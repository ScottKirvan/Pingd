<resources>
    <string name="app_name">UplinkStatus</string>

    <!-- Stage 2: foreground service notification content. -->
    <string name="notification_channel_name">Uplink status</string>
    <string name="notification_channel_description">Ongoing status-bar indicator of uplink (network) connectivity health.</string>
    <string name="notification_title">Uplink status</string>
    <string name="notification_text_connected_with_latency">Uplink: connected, %1$dms</string>
    <string name="notification_text_connected_unknown_latency">Uplink: connected</string>
    <string name="notification_text_disabled">Uplink: paused (network out of scope)</string>
    <!-- Shown instead of notification_text_disabled specifically when network scope is set
         to the SSID whitelist: "out of scope" is technically true but unhelpfully vague
         when what's actually happening is "none of your whitelisted networks are in range." -->
    <string name="notification_text_disabled_ssid_scope">Uplink: waiting for a whitelisted Wi-Fi network…</string>

    <!-- On-screen status line only (SettingsScreen): HIDDEN never has a notification to
         build text for, since hidden means no notification at all, but the status line still
         needs something to say. -->
    <string name="status_text_hidden">Uplink: hidden (master toggle is off, or out of scope with \"hide when disabled\" on)</string>

    <!-- Stage 5: CycleEvent.Frozen accessibility text. Per spec, a DNS problem and a
         network-down problem must not look the same to the user, even though the icon
         itself freezes in place either way (no distinct "lost" frame). -->
    <string name="notification_text_probe_failure">Uplink: connection trouble, retrying…</string>
    <string name="notification_text_dns_failure">Uplink: can\'t resolve target host, retrying…</string>

    <!-- Stage 2: POST_NOTIFICATIONS runtime-permission rationale flow. -->
    <string name="notification_permission_rationale">UplinkStatus shows its connectivity status as a persistent status-bar icon. That requires permission to post a notification — allow it so the icon can be shown.</string>
    <string name="notification_permission_request_button">Allow notifications</string>
    <string name="notification_permission_denied">Notifications permission was denied, so the status icon can\'t be shown. You can grant it from system settings at any time.</string>
</resources>
